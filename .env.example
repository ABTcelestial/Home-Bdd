# Celestial Hub - configuration du serveur.
# Copier ce fichier en ".env" a la racine du projet et adapter les valeurs.

# Mot de passe partage demande a la connexion (obligatoire).
HUB_PASSWORD=changez-moi

# Dossier racine affiche dans le Hub.
# Modifiable ensuite depuis la page Reglages (PC serveur uniquement).
# Windows : HUB_ROOT=C:\CelestialHub
HUB_ROOT=C:\CelestialHub

# Port d'ecoute (3000 par defaut).
PORT=3000

# Interface d'ecoute. 0.0.0.0 = accessible depuis le reseau local.
HOST=0.0.0.0

# Nom affiche dans les reglages pour joindre le Hub sans retenir l'IP.
# Par defaut : le nom Windows du PC serveur (voir deploiement\nom-reseau.ps1).
# HUB_HOSTNAME=celestial-hub

# Intervalle du scan disque en millisecondes (temps reel).
HUB_WATCH_MS=4000

# Emplacement du fichier de configuration local (racine, mot de passe, secret).
# Par defaut : <projet>/data
# HUB_DATA_DIR=C:\CelestialHub\_config
